---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { ALL_FAQS, getRelatedFaqs } from '../../data/faqs';
import type { FullFaqItem } from '../../data/faqs';
import { formatFaqMarkdown } from '../../utils/formatFaqMarkdown';
import '../../styles/global.css';

export async function getStaticPaths() {
  return ALL_FAQS.map((item) => ({
    params: { slug: item.slug },
    props: { faq: item },
  }));
}

export interface Props {
  faq: FullFaqItem;
}

const { faq } = Astro.props;
const relatedFaqs = getRelatedFaqs(faq.slug, 3);

const title = `${faq.q} | 2027梯子推荐 FAQ`;
const description = faq.summary;
const keywords = `${faq.tags.join(', ')}, 2027梯子推荐, tizituijian2027.blog`;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    {
      '@type': 'Question',
      'name': faq.q,
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': faq.summary,
      },
    },
  ],
};

const breadcrumbItems = [
  { name: '常见疑问 FAQ', url: '/faq/' },
  { name: faq.q, url: `/faq/${faq.slug}/` },
];
---

<BaseLayout title={title} description={description} keywords={keywords} schemaJson={faqSchema}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-10">
    <Breadcrumb items={breadcrumbItems} />

    <article class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-6">
      <header class="pb-6 border-b border-slate-200 space-y-3">
        <div class="flex flex-wrap items-center gap-2 text-xs">
          <span class="px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200 font-semibold">
            {faq.category}
          </span>
          <span class="text-slate-400">•</span>
          <span class="text-slate-500">更新于 {faq.updatedAt}</span>
        </div>

        <h1 class="text-2xl sm:text-4xl font-black text-slate-900 leading-tight">
          {faq.q}
        </h1>

        <p class="text-sm sm:text-base text-slate-600 leading-relaxed bg-slate-50 p-4 rounded-xl border border-slate-200">
          {faq.summary}
        </p>

        <div class="flex flex-wrap gap-1.5 pt-1">
          {faq.tags.map((tag) => (
            <span class="px-2.5 py-0.5 rounded-full text-xs bg-sky-50 text-sky-700 border border-sky-200 font-medium">
              #{tag}
            </span>
          ))}
        </div>
      </header>

      <div class="prose-custom max-w-none" set:html={formatFaqMarkdown(faq.a)} />

      <div class="pt-6 border-t border-slate-100 flex flex-wrap justify-between items-center gap-4">
        <a href="/faq/" class="text-sm font-bold text-sky-600 hover:text-sky-700">
          ← 返回全部 FAQ 问答列表
        </a>
        <a
          href="/ranking/"
          class="px-5 py-2.5 rounded-xl font-bold text-xs sm:text-sm bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white shadow-sm"
        >
          查看 2027 精选梯子排行榜 →
        </a>
      </div>
    </article>

    <!-- 相关问题推荐 -->
    <section class="space-y-4">
      <h2 class="text-lg sm:text-xl font-extrabold text-slate-900">📌 相关疑难解答推荐</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {relatedFaqs.map((rel) => (
          <a
            href={`/faq/${rel.slug}/`}
            class="glass-card rounded-xl p-4 block hover:border-sky-400 transition-all"
          >
            <span class="text-[10px] font-semibold text-sky-700 bg-sky-50 px-2 py-0.5 rounded border border-sky-200">
              {rel.category.replace('篇', '')}
            </span>
            <h3 class="text-sm font-bold text-slate-900 mt-2 line-clamp-2">{rel.q}</h3>
            <p class="text-xs text-slate-500 mt-1.5 line-clamp-2">{rel.summary}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
