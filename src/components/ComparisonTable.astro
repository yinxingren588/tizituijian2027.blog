---
import { LADDERS_DATA } from '../data/ladders';
---

<div class="space-y-4">
  <!-- 表格上方的快速筛选与搜索交互栏 -->
  <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 p-4 rounded-xl bg-slate-50 border border-slate-200">
    <div class="flex items-center space-x-2">
      <span class="text-sm font-bold text-slate-900 flex items-center gap-1.5">
        <span>⚡ 梯子快速检索</span>
        <span class="text-xs text-sky-700 bg-sky-50 px-2 py-0.5 rounded-full border border-sky-200 font-mono" id="table-count-badge">
          共 {LADDERS_DATA.length} 款
        </span>
      </span>
    </div>

    <!-- 搜索输入框 -->
    <div class="relative flex-1 sm:max-w-xs">
      <input
        type="text"
        id="table-search-input"
        placeholder="搜索品牌名、流量、价格或优惠码..."
        class="w-full bg-white text-slate-900 placeholder-slate-400 text-xs sm:text-sm rounded-lg px-3 py-2 pl-8 border border-slate-300 focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500"
      />
      <svg class="w-4 h-4 text-slate-400 absolute left-2.5 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>
  </div>

  <!-- 对比表格主体 -->
  <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
    <table class="w-full text-left border-collapse text-sm" id="comparison-data-table">
      <thead>
        <tr class="border-b border-slate-200 bg-slate-50 text-slate-700 font-semibold text-xs sm:text-sm">
          <th class="p-4 whitespace-nowrap">品牌名称</th>
          <th class="p-4 whitespace-nowrap">专线架构</th>
          <th class="p-4 whitespace-nowrap">起步价钱 / 年付特惠</th>
          <th class="p-4 whitespace-nowrap">基础流量套餐</th>
          <th class="p-4 whitespace-nowrap">高峰速率 / SLA</th>
          <th class="p-4 whitespace-nowrap">流媒体 & AI解锁</th>
          <th class="p-4 whitespace-nowrap">优惠码</th>
          <th class="p-4 text-center whitespace-nowrap">套餐详情 / 官网</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200">
        {LADDERS_DATA.map((item) => {
          const hasCoupon = Boolean(item.couponCode && !item.couponCode.includes('自带'));
          return (
            <tr
              class="comparison-row hover:bg-sky-50/40 transition-colors"
              data-brand-row
              data-category={item.category}
              data-search-term={`${item.name} ${item.lineType} ${item.traffic} ${item.monthlyPrice} ${item.annualDiscount || ''} ${item.couponCode || ''} ${item.protocols.join(' ')} ${item.streamingUnlock.join(' ')} ${item.features.join(' ')}`.toLowerCase()}
            >
              <!-- 梯子名称 -->
              <td class="p-4 font-bold text-slate-900 whitespace-nowrap">
                <div class="flex items-center space-x-2.5">
                  <span class={`w-6 h-6 rounded-md text-xs font-mono flex items-center justify-center shrink-0 ${
                    item.rank === 1
                      ? 'bg-amber-50 text-amber-700 border border-amber-300 font-black'
                      : item.rank <= 3
                      ? 'bg-sky-50 text-sky-700 border border-sky-200 font-bold'
                      : 'bg-slate-100 text-slate-600 border border-slate-200'
                  }`}>
                    {item.rank}
                  </span>
                  <div>
                    <a href={item.reviewSlug} class="hover:text-sky-600 transition-colors">
                      {item.name}
                    </a>
                    <span class="block text-xs font-normal text-slate-500 mt-0.5">
                      {item.badge.replace(/^[👑⚡💰🧳💼]\s*/, '')} · <span class="text-amber-500">★</span> {item.rating}
                    </span>
                  </div>
                </div>
              </td>

              <!-- 专线架构 -->
              <td class="p-4 text-slate-700 whitespace-nowrap">
                <span class="px-2 py-1 rounded bg-slate-100 text-xs text-sky-700 border border-slate-200 font-medium">
                  {item.lineType}
                </span>
              </td>

              <!-- 起步价钱与年付优惠 -->
              <td class="p-4 whitespace-nowrap">
                <div class="text-sky-600 font-extrabold font-mono">{item.monthlyPrice}</div>
                {item.annualDiscount && (
                  <span class="block text-[11px] text-amber-700 mt-0.5 max-w-[190px] truncate" title={item.annualDiscount}>
                    {item.annualDiscount}
                  </span>
                )}
              </td>

              <!-- 流量套餐 -->
              <td class="p-4 whitespace-nowrap">
                <span class="px-2 py-1 rounded-md bg-slate-50 border border-slate-200 text-xs font-bold text-slate-800">
                  {item.traffic}
                </span>
              </td>

              <!-- 测速与 SLA -->
              <td class="p-4 whitespace-nowrap">
                <div class="text-emerald-600 font-bold text-xs sm:text-sm">
                  ⚡ {item.speedRating} ({item.speedMbps} Mbps)
                </div>
                <span class="block text-[11px] font-normal text-slate-500 mt-0.5">
                  在线率 {item.uptime} · {item.latency.replace('平均 ', '')}
                </span>
              </td>

              <!-- 解锁能力 -->
              <td class="p-4 text-slate-700">
                <div class="flex flex-wrap gap-1 max-w-[200px]">
                  {item.streamingUnlock.slice(0, 3).map((tag) => (
                    <span class="px-1.5 py-0.5 rounded text-[11px] bg-emerald-50 text-emerald-700 border border-emerald-200">
                      {tag}
                    </span>
                  ))}
                </div>
              </td>

              <!-- 优惠码 -->
              <td class="p-4 whitespace-nowrap">
                {hasCoupon ? (
                  <button
                    type="button"
                    class="px-2 py-1 rounded bg-amber-50 text-amber-700 border border-amber-200 hover:bg-amber-100 text-xs font-mono font-bold transition-colors"
                    data-copy-coupon={item.couponCode}
                    title={item.couponText || '点击复制优惠码'}
                  >
                    {item.couponCode} 📋
                  </button>
                ) : item.couponCode ? (
                  <span class="text-xs text-amber-700 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">
                    {item.couponCode}
                  </span>
                ) : (
                  <span class="text-slate-400 text-xs">-</span>
                )}
              </td>

              <!-- 操作：套餐明细页 + 前往官网 -->
              <td class="p-4 text-center whitespace-nowrap">
                <div class="flex items-center justify-center gap-2">
                  <a
                    href={item.reviewSlug}
                    class="px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-sky-50 hover:bg-sky-100 text-sky-700 border border-sky-200 transition-colors"
                  >
                    {item.packages.length}档套餐
                  </a>
                  <a
                    href={item.affUrl}
                    target="_blank"
                    rel="noopener noreferrer sponsored"
                    class="px-3 py-1.5 rounded-lg text-xs font-bold bg-sky-500 hover:bg-sky-600 text-white transition-all shadow-sm shadow-sky-500/20"
                  >
                    前往官网 →
                  </a>
                </div>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('table-search-input');
    const tableRows = document.querySelectorAll('[data-brand-row]');
    const countBadge = document.getElementById('table-count-badge');

    if (searchInput && tableRows.length) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        let visibleCount = 0;

        tableRows.forEach((row) => {
          const term = row.getAttribute('data-search-term') || '';
          if (!query || term.includes(query)) {
            row.style.display = '';
            visibleCount++;
          } else {
            row.style.display = 'none';
          }
        });

        if (countBadge) {
          countBadge.innerText = `显示 ${visibleCount} 款`;
        }
      });
    }
  });
</script>
