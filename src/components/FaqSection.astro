---
import { FAQS_DATA } from '../data/faqs';
import { formatFaqMarkdown } from '../utils/formatFaqMarkdown';
---

<div class="space-y-4">
  {FAQS_DATA.map((faq, index) => (
    <details class="group glass-card rounded-2xl p-5 sm:p-6 transition-all duration-200 open:border-sky-400">
      <summary class="flex items-center justify-between cursor-pointer font-bold text-base sm:text-lg text-slate-900 group-hover:text-sky-600 transition-colors list-none">
        <span class="flex items-center space-x-3 pr-4">
          <span class="w-6 h-6 rounded-md bg-sky-50 text-sky-600 text-xs flex items-center justify-center shrink-0 border border-sky-200 font-mono">
            Q{index + 1}
          </span>
          <span>{faq.question}</span>
        </span>
        <span class="text-sky-600 text-xl font-mono transition-transform duration-200 group-open:rotate-45 shrink-0">
          +
        </span>
      </summary>
      <div class="mt-4 pt-4 border-t border-slate-100 text-sm sm:text-base text-slate-600 leading-relaxed pl-2 sm:pl-9 space-y-2">
        <div set:html={formatFaqMarkdown(faq.answer)} />
        {faq.slug && (
          <div class="pt-2">
            <a
              href={`/faq/${faq.slug}/`}
              class="inline-flex items-center text-xs font-bold text-sky-600 hover:text-sky-700 bg-sky-50 px-3 py-1 rounded-lg border border-sky-200"
            >
              阅读该问题独立详情页 →
            </a>
          </div>
        )}
      </div>
    </details>
  ))}
</div>
