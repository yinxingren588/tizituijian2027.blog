---
export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  author?: string;
  tags?: string[];
}

const {
  title,
  description,
  pubDate,
  slug,
  author = '2027梯子测评团队',
  tags = [],
} = Astro.props;

const formattedDate = pubDate.toISOString().split('T')[0];
---

<article class="glass-card rounded-2xl p-6 sm:p-7 flex flex-col justify-between group hover:border-sky-400 transition-all">
  <div>
    <!-- 标签与日期 -->
    <div class="flex items-center justify-between text-xs text-slate-500 mb-3">
      <div class="flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="px-2 py-0.5 rounded bg-sky-50 text-sky-700 border border-sky-200 font-medium">
            {tag}
          </span>
        ))}
      </div>
      <time datetime={formattedDate}>{formattedDate}</time>
    </div>

    <!-- 标题 -->
    <h3 class="text-lg sm:text-xl font-bold text-slate-900 group-hover:text-sky-600 transition-colors line-clamp-2 mb-3">
      <a href={`/posts/${slug}/`}>
        {title}
      </a>
    </h3>

    <!-- 摘要 -->
    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed line-clamp-3 mb-6">
      {description}
    </p>
  </div>

  <!-- 底部作者与阅读动作 -->
  <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
    <span>✍️ {author}</span>
    <a
      href={`/posts/${slug}/`}
      class="text-sky-600 font-semibold group-hover:text-sky-700 flex items-center space-x-1"
    >
      <span>阅读全文</span>
      <span class="group-hover:translate-x-1 transition-transform">→</span>
    </a>
  </div>
</article>
