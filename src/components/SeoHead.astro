---
import { SITE_CONFIG } from '../data/site';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  articleAuthor?: string;
  schemaJson?: Record<string, any> | Record<string, any>[];
}

const {
  title = SITE_CONFIG.title,
  description = SITE_CONFIG.description,
  keywords = SITE_CONFIG.keywords,
  canonicalUrl = Astro.url.href,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  articleAuthor = SITE_CONFIG.author,
  schemaJson,
} = Astro.props;

// 确保规范 URL 使用正式域名 https://tizituijian2027.blog
const resolvedCanonical = new URL(Astro.url.pathname, SITE_CONFIG.url).href;

// 默认基础结构化数据 (WebSite & Organization)
const defaultWebsiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': SITE_CONFIG.name,
  'alternateName': ['2027梯子推荐网', 'tizituijian2027.blog'],
  'url': SITE_CONFIG.url,
  'description': SITE_CONFIG.description,
  'inLanguage': 'zh-CN',
  'potentialAction': {
    '@type': 'SearchAction',
    'target': `${SITE_CONFIG.url}/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const defaultOrgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': SITE_CONFIG.name,
  'url': SITE_CONFIG.url,
  'logo': `${SITE_CONFIG.url}/favicon.svg`,
  'sameAs': [SITE_CONFIG.url],
};

const schemasToRender = schemaJson
  ? Array.isArray(schemaJson)
    ? [defaultWebsiteSchema, defaultOrgSchema, ...schemaJson]
    : [defaultWebsiteSchema, defaultOrgSchema, schemaJson]
  : [defaultWebsiteSchema, defaultOrgSchema];
---

<!-- 核心字符集与移动视口 -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<meta name="generator" content={Astro.generator} />

<!-- 核心 Bing / Google SEO 标题与元数据 (精准匹配 "2027梯子推荐") -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content={articleAuthor} />
<link rel="canonical" href={resolvedCanonical} />

<!-- 搜索引擎爬虫指示 (Bingbot 专项优化：允许大图、完整摘要) -->
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large" />
<meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large" />

<!-- Bing IndexNow 自动发现与推送凭证关联 -->
<link rel="indexnow" href="/e9a8f273b1454c5e89d14f2a781290bc.txt" />

<!-- Open Graph 社交卡片 -->
<meta property="og:site_name" content={SITE_CONFIG.name} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={resolvedCanonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={`${SITE_CONFIG.url}/favicon.svg`} />
<meta property="og:locale" content={SITE_CONFIG.locale} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={`${SITE_CONFIG.url}/favicon.svg`} />

<!-- 结构化数据 Schema.org JSON-LD (极大增强 Bing 搜索富媒体结果展现) -->
{schemasToRender.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
